\setvar font-family Gilroy Bold
\setvar font-size 30

\slide[defineclass: titlepage] titlepage
\image[class: fullscreen] images/fondo_1.svg
\text[defineclass: title; font-size: 60; color: #bda; text-align:center]%{title}

\text[defineclass: subtitle; font-size: 50; color: #fff;text-align:center]%{subtitle}
\text[defineclass: author; font-size: 30; color: #fff] %{author}
\image[defineclass: image]
\image images/jim.svg 


\slide[defineclass: default] default
\image[class: fullscreen] images/fondo_1.svg
\text[defineclass: title; font-size: 50; color: #bda;text-align:center]%{title}
\text[defineclass: body; font-family: Gilroy;color:#fff;font-size: 35]
\image images/jim.svg 
\text[color:#A1C;font-size:20]%{pagenumber}
